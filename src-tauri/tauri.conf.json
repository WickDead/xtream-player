{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xtream Player",
  "version": "0.1.1",
  "identifier": "com.xtreamplayer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Xtream Player",
        "width": 1440,
        "height": 960,
        "resizable": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico"
    ],
    "targets": "all",
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}