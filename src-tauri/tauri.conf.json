{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xtream Player",
  "version": "0.1.2",
  "identifier": "io.opensourceiptv.xtreamplayer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Xtream Player",
        "width": 1440,
        "height": 960,
        "resizable": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Open Source IPTV",
    "icon": [
      "icons/icon.ico"
    ],
    "targets": "msi",
    "windows": {
      "allowDowngrades": false,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "upgradeCode": "3ffe16e5-7a2b-5671-8979-24dc7af787a1"
      }
    }
  }
}
