<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:XtreamPlayer.App.ViewModels"
             xmlns:models="clr-namespace:XtreamPlayer.Core.Models;assembly=XtreamPlayer.Core"
             xmlns:mig="clr-namespace:XtreamPlayer.Infrastructure.Migration;assembly=XtreamPlayer.Infrastructure"
             x:Class="XtreamPlayer.App.Views.ProvidersPage"
             x:DataType="vm:ProvidersPageViewModel">

  <ScrollViewer>
    <StackPanel Margin="28,24" Spacing="22" MaxWidth="760" HorizontalAlignment="Left">

      <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="8" Padding="18"
              IsVisible="{Binding HasLegacyDatabases}">
        <StackPanel Spacing="10">
          <TextBlock Classes="h3" Text="Import from the previous version" />
          <TextBlock Classes="muted" TextWrapping="Wrap" TextTrimming="None"
                     Text="Providers, favorites and watch history can be brought across. The original files are opened read-only and are never modified." />
          <ItemsControl ItemsSource="{Binding LegacyDatabases}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="mig:LegacyDatabaseInfo">
                <Border Background="{DynamicResource SurfaceSunken}" CornerRadius="5"
                        Padding="12" Margin="0,4">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="3">
                      <TextBlock FontSize="{DynamicResource TextMd}">
                        <Run Text="{Binding ProfileCount}" /><Run Text=" provider(s), " />
                        <Run Text="{Binding FavoriteCount}" /><Run Text=" favorite(s)" />
                      </TextBlock>
                      <TextBlock Classes="mono muted" Text="{Binding Path}" />
                      <TextBlock Classes="muted" Text="{Binding ModifiedAt}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="accent" Content="Import"
                            VerticalAlignment="Center" IsEnabled="{Binding IsUsable}"
                            Command="{Binding $parent[UserControl].((vm:ProvidersPageViewModel)DataContext).ImportCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Providers" />
        <ItemsControl ItemsSource="{Binding Profiles}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Profile">
              <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="6"
                      Padding="14" Margin="0,4">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                               FontSize="{DynamicResource TextMd}" />
                    <TextBlock Classes="mono muted">
                      <Run Text="{Binding Username}" /><Run Text=" @ " /><Run Text="{Binding ServerUrl}" />
                    </TextBlock>
                    <!-- Shown when the database came from another machine and
                         DPAPI could not decrypt the stored password. -->
                    <TextBlock Classes="muted" Foreground="{DynamicResource Warning}"
                               Text="Password could not be decrypted - please re-enter it"
                               IsVisible="{Binding PasswordUnavailable}" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="ghost" Content="Edit" Margin="6,0"
                          Command="{Binding $parent[UserControl].((vm:ProvidersPageViewModel)DataContext).EditCommand}"
                          CommandParameter="{Binding}" />
                  <Button Grid.Column="2" Classes="ghost" Content="Delete"
                          Command="{Binding $parent[UserControl].((vm:ProvidersPageViewModel)DataContext).DeleteCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="8" Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Classes="h3" Text="Add a provider" />

          <StackPanel Spacing="8">
            <TextBox Watermark="Name" Text="{Binding Name, Mode=TwoWay}" />
            <TextBox Watermark="Server address, for example http://example.com:8080"
                     Text="{Binding ServerUrl, Mode=TwoWay}" />
            <TextBox Watermark="Username" Text="{Binding Username, Mode=TwoWay}" />
            <TextBox Watermark="Password" PasswordChar="*" Text="{Binding Password, Mode=TwoWay}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Test connection" Command="{Binding TestCommand}" />
            <Button Classes="accent" Content="Save" Command="{Binding SaveCommand}" />
            <Button Classes="ghost" Content="Clear" Command="{Binding ClearFormCommand}" />
          </StackPanel>

          <TextBlock Text="{Binding TestResult}" TextWrapping="Wrap" TextTrimming="None"
                     IsVisible="{Binding TestResult, Converter={x:Static ObjectConverters.IsNotNull}}"
                     Foreground="{DynamicResource TextSecondary}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
