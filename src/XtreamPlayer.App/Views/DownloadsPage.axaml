<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:XtreamPlayer.App.ViewModels"
             x:Class="XtreamPlayer.App.Views.DownloadsPage"
             x:DataType="vm:DownloadsPageViewModel">

  <Grid RowDefinitions="Auto,*,Auto">

    <Border Grid.Row="0" Background="{DynamicResource Surface}" Padding="18,14">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="3">
          <TextBlock Classes="h2" Text="Downloads" />
          <TextBlock Classes="muted" Text="{Binding Folder}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Button Grid.Column="1" Content="Open folder" VerticalAlignment="Center"
                Command="{Binding OpenFolderCommand}" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" Padding="18,14">
      <StackPanel Spacing="18">

        <!-- Recordings first: they are live and time-sensitive in a way a
             queued download is not. -->
        <StackPanel Spacing="8" IsVisible="{Binding HasRecordings}">
          <TextBlock Classes="h3" Text="Recording now" />

          <ItemsControl ItemsSource="{Binding Recordings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RecordingViewModel">
                <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="6"
                        Padding="14,12" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,12,0"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource LiveDot}" />

                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="{Binding ChannelName}" />
                      <TextBlock Classes="muted" Text="{Binding ProgrammeTitle}"
                                 IsVisible="{Binding ProgrammeTitle, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      <TextBlock Classes="muted" Text="{Binding StatusText}" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="Stop" VerticalAlignment="Center"
                            Command="{Binding $parent[ItemsControl].((vm:DownloadsPageViewModel)DataContext).StopRecordingCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding HasJobs}">
          <TextBlock Classes="h3" Text="Queue" />

          <ItemsControl ItemsSource="{Binding Jobs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DownloadJobViewModel">
                <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="6"
                        Padding="14,12" Margin="0,0,0,8">
                  <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">

                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="muted" Text="{Binding StatusText}" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                                Spacing="6" VerticalAlignment="Center">
                      <Button Content="Play"
                              IsVisible="{Binding CanPlay}"
                              Command="{Binding $parent[ItemsControl].((vm:DownloadsPageViewModel)DataContext).PlayCommand}"
                              CommandParameter="{Binding}" />

                      <Button Content="Pause"
                              IsVisible="{Binding CanPause}"
                              Command="{Binding $parent[ItemsControl].((vm:DownloadsPageViewModel)DataContext).PauseCommand}"
                              CommandParameter="{Binding}" />

                      <Button Content="Resume"
                              IsVisible="{Binding CanResume}"
                              Command="{Binding $parent[ItemsControl].((vm:DownloadsPageViewModel)DataContext).ResumeCommand}"
                              CommandParameter="{Binding}" />

                      <Button Content="Remove"
                              Command="{Binding $parent[ItemsControl].((vm:DownloadsPageViewModel)DataContext).RemoveCommand}"
                              CommandParameter="{Binding}" />
                    </StackPanel>

                    <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                 Margin="0,10,0,0" Height="4"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding ProgressPercent}"
                                 IsIndeterminate="{Binding IsIndeterminate}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Border IsVisible="{Binding IsEmpty}" Padding="0,60">
          <StackPanel Spacing="10" HorizontalAlignment="Center">
            <TextBlock Classes="h3" HorizontalAlignment="Center" Text="Nothing downloading" />
            <TextBlock Classes="muted" HorizontalAlignment="Center" MaxWidth="440"
                       TextWrapping="Wrap"
                       Text="Download a movie or an episode from its page, or record a live channel from the player." />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{DynamicResource Surface}" Padding="18,10"
            IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Classes="muted" Text="{Binding Status}" />
    </Border>
  </Grid>
</UserControl>
