<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Control styles.

    Transitions are deliberately short (80-120ms) and limited to opacity and
    background. Anything longer feels laggy when moving through a list quickly,
    and animating layout properties on a virtualized grid causes visible jank
    during fast scrolling.
  -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource AppBackground}" />
    <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="FontSize" Value="{DynamicResource TextMd}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="{DynamicResource TextXxl}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="{DynamicResource TextXl}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="{DynamicResource TextLg}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="FontSize" Value="{DynamicResource TextSm}" />
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
    <Setter Property="FontSize" Value="{DynamicResource TextXs}" />
  </Style>

  <!-- buttons -->

  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="FontSize" Value="{DynamicResource TextMd}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.10" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="Button:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceActive}" />
  </Style>

  <Style Selector="Button:disabled /template/ ContentPresenter">
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextDisabled}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.accent /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="TextBlock.Foreground" Value="#0B0B10" />
    <Setter Property="TextBlock.FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentDim}" />
  </Style>

  <!-- Icon-only buttons: square, quiet until hovered. -->
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="FontSize" Value="{DynamicResource TextLg}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.icon /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="FontSize" Value="{DynamicResource TextSm}" />
  </Style>

  <Style Selector="Button.ghost /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
  </Style>

  <!-- text input -->

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FontSize" Value="{DynamicResource TextMd}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentSubtle}" />
  </Style>

  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>

  <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
    <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
  </Style>

  <!-- lists -->

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <!-- Selection uses a subtle tint plus an accent bar rather than a solid fill,
       which would fight with poster artwork. -->
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
  </Style>

  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSubtle}" />
  </Style>

  <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSubtle}" />
  </Style>

  <!-- scrollbars -->

  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ScrollBar:vertical /template/ Border#TrackRect">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Opacity" Value="0" />
  </Style>

  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource Neutral600}" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>

  <Style Selector="ScrollBar:pointerover /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource Neutral500}" />
  </Style>

  <!-- combo -->

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontSize" Value="{DynamicResource TextSm}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <!-- misc -->

  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource Divider}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,6" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Background" Value="{DynamicResource Neutral750}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="MinHeight" Value="3" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource SurfaceActive}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="FontSize" Value="{DynamicResource TextSm}" />
  </Style>

</Styles>
