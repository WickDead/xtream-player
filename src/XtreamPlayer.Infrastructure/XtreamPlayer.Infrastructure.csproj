<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>XtreamPlayer.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../XtreamPlayer.Application/XtreamPlayer.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <!-- Season inference and the foreign-database guard are internal logic with
         real behaviour worth asserting directly. -->
    <InternalsVisibleTo Include="XtreamPlayer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Migrations are embedded so the runner cannot go looking on disk and
         find a half-deployed or edited copy. -->
    <EmbeddedResource Include="Persistence/Migrations/*.sql" />
  </ItemGroup>

</Project>
