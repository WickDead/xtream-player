<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:XtreamPlayer.App"
             x:Class="XtreamPlayer.App.App"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>
    <app:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://XtreamPlayer/Themes/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://XtreamPlayer/Themes/Controls.axaml" />
  </Application.Styles>
</Application>
