<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:XtreamPlayer.App.ViewModels"
             xmlns:media="clr-namespace:XtreamPlayer.App.Media"
             xmlns:beh="clr-namespace:XtreamPlayer.App.Behaviors"
             x:Class="XtreamPlayer.App.Views.SeriesPage"
             x:DataType="vm:SeriesPageViewModel">

  <Grid ColumnDefinitions="248,*">

    <Border Grid.Column="0" Background="{DynamicResource Surface}">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Margin="12,12,12,8" Spacing="8">
          <TextBlock Classes="h3" Text="Categories" />
          <ComboBox HorizontalAlignment="Stretch"
                    SelectedIndex="{Binding CategorySort, Converter={x:Static vm:EnumIndexConverter.Instance}}">
            <ComboBoxItem Content="Provider order" />
            <ComboBoxItem Content="Name" />
            <ComboBoxItem Content="Size" />
          </ComboBox>
        </StackPanel>

        <ListBox Grid.Row="1" Margin="6,0" ItemsSource="{Binding Categories}"
                 SelectedItem="{Binding SelectedCategory}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CategoryRowViewModel">
              <Grid ColumnDefinitions="*,Auto,Auto" Height="32">
                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                           Margin="8,0" FontSize="{DynamicResource TextSm}"
                           Opacity="{Binding IsHidden, Converter={x:Static vm:HiddenOpacityConverter.Instance}}" />
                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding CountLabel}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <Button Grid.Column="2" Classes="icon" Padding="4" MinWidth="26"
                        IsVisible="{Binding CanHide}" ToolTip.Tip="Hide this category"
                        Content="{Binding IsHidden, Converter={x:Static vm:HideGlyphConverter.Instance}}"
                        Command="{Binding $parent[UserControl].((vm:SeriesPageViewModel)DataContext).ToggleCategoryHiddenCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="2" Classes="ghost" Margin="12,8" HorizontalAlignment="Stretch"
                Command="{Binding ToggleShowHiddenCommand}"
                Content="{Binding ShowHiddenCategories, Converter={x:Static vm:ShowHiddenLabelConverter.Instance}}" />
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="14,12,14,8">
        <TextBox Grid.Column="0" Watermark="Search series"
                 Text="{Binding SearchText, Mode=TwoWay}" />

        <ComboBox Grid.Column="1" Margin="8,0" MinWidth="120"
                  SelectedIndex="{Binding Sort, Converter={x:Static vm:EnumIndexConverter.Instance}}">
          <ComboBoxItem Content="Provider order" />
          <ComboBoxItem Content="Name" />
          <ComboBoxItem Content="Newest" />
        </ComboBox>

        <TextBlock Grid.Column="2" Classes="muted" Text="{Binding ResultSummary}"
                   VerticalAlignment="Center" />
      </Grid>

      <!--
        Row chunking, not a wrap panel.

        Avalonia 11.3 ships no wrap-virtualizing panel at all - no
        VirtualizingWrapPanel, and neither ItemsRepeater nor UniformGridLayout
        exists in the framework assemblies. A WrapPanel as ItemsPanel does not
        virtualize, and 68,595 posters would kill the app.

        So the view model chunks results into fixed-width rows and this is an
        ordinary ListBox over a VirtualizingStackPanel: uniform row heights,
        the battle-tested vertical virtualization path, and scroll restoration
        that is exact arithmetic.
      -->
      <ListBox Grid.Row="1" Margin="8,0,8,8" x:Name="PosterRows"
               ItemsSource="{Binding Rows}"
               SelectionMode="Single"
               beh:ScrollAnchor.Key="posters"
               beh:ScrollAnchor.Page="{Binding}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.Styles>
          <!-- Rows are layout, not selectable content. -->
          <Style Selector="ListBoxItem">
            <Setter Property="IsHitTestVisible" Value="True" />
          </Style>
          <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
          </Style>
          <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
          </Style>
        </ListBox.Styles>

        <ListBox.ItemTemplate>
          <DataTemplate>
            <ItemsControl ItemsSource="{Binding Items}" Height="304">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>

              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SeriesItemViewModel">
                  <Button Classes="ghost" Padding="0" Width="168" Height="296" Margin="4"
                          Command="{Binding $parent[UserControl].((vm:SeriesPageViewModel)DataContext).OpenCommand}"
                          CommandParameter="{Binding}">
                    <StackPanel Spacing="6">
                      <Panel Height="252">
                        <media:AsyncImage Source="{Binding PosterUrl}" DecodeWidth="200"
                                          Stretch="UniformToFill" CornerRadius="6"
                                          Placeholder="{DynamicResource PosterPlaceholder}" />

                        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6"
                                Background="#CC000000" CornerRadius="3" Padding="5,2"
                                IsVisible="{Binding HasRating}">
                          <TextBlock Text="{Binding Rating}" FontSize="{DynamicResource TextXs}"
                                     Foreground="{DynamicResource Favorite}" />
                        </Border>

                        <Button Classes="icon" VerticalAlignment="Top" HorizontalAlignment="Right"
                                Margin="2" Padding="5"
                                Foreground="{Binding IsFavorite, Converter={x:Static vm:FavoriteBrushConverter.Instance}}"
                                Content="{Binding IsFavorite, Converter={x:Static vm:StarGlyphConverter.Instance}}"
                                Command="{Binding $parent[UserControl].((vm:SeriesPageViewModel)DataContext).ToggleFavoriteCommand}"
                                CommandParameter="{Binding}" />
                      </Panel>

                      <StackPanel Spacing="1" Margin="2,0">
                        <TextBlock Text="{Binding Name}" FontSize="{DynamicResource TextSm}"
                                   MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Left" />
                        <TextBlock Classes="muted" Text="{Binding YearLabel}"
                                   FontSize="{DynamicResource TextXs}"
                                   HorizontalAlignment="Left"
                                   IsVisible="{Binding HasYear}" />
                      </StackPanel>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Grid>
</UserControl>
